{
  "name": "@jdipper/homebridge-fastwarm",
  "displayName": "FastWarm Local",
  "version": "0.1.0-jdipper.1",
  "description": "Local FastWarm ET-63 thermostat controls and native schedules for Homebridge and Heating Programmes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdipper/homebridge-fastwarm.git"
  },
  "homepage": "https://github.com/jdipper/homebridge-fastwarm#readme",
  "bugs": {
    "url": "https://github.com/jdipper/homebridge-fastwarm/issues"
  },
  "engines": {
    "homebridge": "^1.8.0 || ^2.0.0",
    "node": "^20 || ^22 || ^24 || ^25"
  },
  "peerDependencies": {
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "main": "dist/index.js",
  "files": [
    "dist/",
    "homebridge-ui/",
    "docs/",
    "config.schema.json",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint src --ext .ts --max-warnings=0",
    "test": "jest --watchman=false",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "keywords": [
    "homebridge-plugin",
    "homekit",
    "fastwarm",
    "thermostat",
    "local"
  ],
  "dependencies": {
    "@homebridge/plugin-ui-utils": "2.2.7",
    "async-await-retry": "2.0.1"
  },
  "devDependencies": {
    "@types/jest": "29.2.4",
    "@types/node": "22.19.12",
    "@typescript-eslint/eslint-plugin": "5.46.0",
    "@typescript-eslint/parser": "5.46.0",
    "eslint": "8.57.1",
    "homebridge": "2.1.1",
    "jest": "29.7.0",
    "rimraf": "5.0.10",
    "ts-jest": "29.4.11",
    "ts-node": "10.9.1",
    "typescript": "5.9.3"
  },
  "homebridge": {
    "plugin_type": "platform",
    "platform": "FastWarmPlatform"
  }
}
